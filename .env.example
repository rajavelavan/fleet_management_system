# ==============================================================================
# Environment Configuration - Real-Time Logistics & Fleet Management System
# ==============================================================================

# Application Settings
PROJECT_NAME="Fleet & Logistics Management System"
VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Security & JWT Authentication
JWT_SECRET_KEY="fleet-logistics-jwt-super-secret-key-32bytesmin"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=False
COOKIE_SAMESITE="lax"

# PostgreSQL + PostGIS Settings
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="fleet_db"

# Optional direct database connection string override (asyncpg)
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/fleet_db"

# Redis Settings
REDIS_HOST="localhost"
REDIS_PORT=6379

# Google Maps / Routes API Key
GOOGLE_MAPS_API_KEY=""

# Optional direct Redis connection string override
# REDIS_URL="redis://localhost:6379/0"

# CORS Allowed Origins (Comma-separated or JSON list)
BACKEND_CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

# Frontend Settings
VITE_API_BASE_URL="http://localhost:8000"
